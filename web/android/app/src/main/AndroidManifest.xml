<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Links: open rove.tablerus.es URLs in the app instead of the browser.
                 The host comes from a manifest placeholder (see app/build.gradle) so a fork or a
                 self-hosted deployment changes it in one place.

                 android:autoVerify makes Android fetch /.well-known/assetlinks.json from that host
                 at install time and check it names this app's package and signing certificate.
                 The server route that answers it is in server/src/app.ts, and it needs the signing
                 certificate's SHA-256 in ANDROID_CERT_FINGERPRINTS. With that unset the links still
                 work, they just prompt.

                 Path prefixes rather than the whole host, deliberately. A bare host filter would
                 also capture /api/*, which is the app's own REST endpoint — including the OAuth
                 callback path. Every route here is one the router actually has, and
                 web/src/lib/deepLinks.ts must agree with this list: a test asserts they do. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="${appHost}" />
                <data android:pathPrefix="/map" />
                <data android:pathPrefix="/list" />
                <data android:pathPrefix="/add" />
                <data android:pathPrefix="/settings" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Periodic background sync (lib/backgroundSync.ts): WorkManager needs a wake lock to hold the
         device awake for the length of a fetch event, and the boot receiver needs this to re-register
         the periodic task after a reboot (startOnBoot). The background-fetch AAR declares both too,
         but they're spelled out here so a permission the app requests is visible in the app's own
         manifest rather than only in a merged dependency. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Package visibility (Android 11+ / targetSdk 36): without this the WebView cannot resolve
         the hand-off to the maps app, and the Navigate button silently does nothing. Amap first,
         since Shenzhen is the region that exists; the generic VIEW query covers whichever maps app
         a later region hands off to. -->
    <queries>
        <package android:name="com.autonavi.minimap" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="androidamap" />
        </intent>
    </queries>
</manifest>
